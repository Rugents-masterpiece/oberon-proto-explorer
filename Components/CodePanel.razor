<div class="code-panel">
    <div class="code-copy-toolbar">
        <button type="button" class="code-copy-button" data-copy-code aria-label="Skopírovať kód" title="Skopírovať kód">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                <rect x="8" y="8" width="12" height="12" rx="2" />
                <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
            </svg>
        </button>
        <span class="code-copy-feedback" role="status" aria-live="polite" aria-atomic="true"></span>
    </div>
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
